{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "lib": [
      "ES2023"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "$lib/*": [
        "lib/*"
      ],
      "$service/*": [
        "service/*"
      ],
      "$shell/*": [
        "shell/*"
      ],
      "ags": [
        "node_modules/ags/lib/index.ts"
      ],
      "ags/*": [
        "node_modules/ags/lib/*"
      ],
      "widget/*": [
        "widget/*"
      ]
    },
    "strict": true,
    "target": "ES2020"
  }
}